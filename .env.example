# DashScope API key used by the embedding and chat models.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# Beijing shared endpoint. Change this together with an API key from the same region.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Pin a dated snapshot in production after regression testing if model drift matters.
RAG_CHAT_MODEL=qwen3.7-plus
RAG_EMBEDDING_MODEL=text-embedding-v4

# Optional. History stays in memory unless this is explicitly enabled.
RAG_HISTORY_PERSIST=false
RAG_HISTORY_RETENTION_DAYS=7

# Optional. Changing the collection name creates a logically isolated index.
RAG_COLLECTION_NAME=rag_v2
RAG_RETRIEVAL_K=4
RAG_SCORE_THRESHOLD=0.50

# Use a long, random value. This token protects the knowledge-base admin page.
RAG_ADMIN_TOKEN=replace-with-a-long-random-admin-token
